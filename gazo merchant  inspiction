async function saveBackupFile(name,content,type){const blob=new Blob(['\ufeff'+content],{type});if(window.showSaveFilePicker){try{const handle=await window.showSaveFilePicker({suggestedName:name,types:[{description:'Gazo backup file',accept:{[type.split(';')[0]]:[name.endsWith('.json')?'.json':'.txt']}}]});const writable=await handle.createWritable();await writable.write(blob);await writable.close();alert('ምትኬው በመረጡት ፋይል ተቀምጧል። ቀጣይ ጊዜ ያንኑ ፋይል መርጠው በአዲሱ መተካት ይችላሉ።');return}catch(e){if(e&&e.name==='AbortError')return;}}download(name,content,type);alert('ምትኬው ወርዷል። ይህ አሳሽ በቀጥታ የቀድሞ ፋይልን መተካት ካልደገፈ፣ ተመሳሳይ ስም ያለው ተጨማሪ ፋይል ሊፈጠር ይችላል። የአፑ መረጃ ግን በአሳሹ ውስጥ በራሱ ይቀመጣል።')}function download(name,content,type){let blob=new Blob(['\ufeff'+content],{type}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000)}
function renewalAm(v){return v==='renewed'?'ታድሷል':v==='not_renewed'?'አልታደሰም':v==='new'?'አዲስ':'አልተመረጠም'}
function exportReadableBackup(filename){
 let out=['የጋዞ ወረዳ የንግድ ቁጥጥር — የሚነበብ ምትኬ','የተዘጋጀበት ቀን፦ '+ethiopianDate(new Date()),'','==============================','1. የነጋዴዎች ዝርዝር','=============================='];
 if(!merchants.length) out.push('ምንም ነጋዴ አልተመዘገበም።');
 merchants.forEach((m,i)=>{out.push('',(i+1)+'. የነጋዴ ስም፦ '+(m.name||'—'),'   TIN፦ '+(m.tin||'—'),'   የንግድ ዘርፍ፦ '+(m.sector||'—'),'   ስልክ፦ '+(m.phone||'—'),'   ቀበሌ፦ '+(m.kebele||'—'),'   የነጋዴ ምደባ፦ '+(m.classification==='classified'?'የተፈረጀ':m.classification==='unclassified'?'ያልተፈረጀ':'ምደባ አልተመዘገበም'),'   የፈቃድ እድሳት፦ '+renewalAm(m.renewal));});
 out.push('','==============================','2. የቁጥጥር ውጤቶች','==============================');
 if(!inspections.length) out.push('ምንም ቁጥጥር አልተመዘገበም።');
 inspections.forEach((r,i)=>{out.push('',(i+1)+'. የነጋዴ ስም፦ '+(r.name||'—'),'   ቀን፦ '+(r.date?ethiopianDate(r.date):'—'),'   ሩብ ዓመት፦ '+(r.quarter?(r.quarter+'ኛ ሩብ ዓመት'):'—'),'   TIN፦ '+(r.tin||'—'),'   የፈቃድ ሁኔታ፦ '+renewalAm(r.renewal),'   የተቆጣጣሪ ስም፦ '+(r.inspectorName||'—'),'   የ6ቱ መስፈርቶች፦');criteria.forEach((c,j)=>out.push('      '+(j+1)+'. '+c+' — '+(r.answers&&r.answers[j]==='yes'?'አሟልቷል':r.answers&&r.answers[j]==='no'?'አላሟላም':'አልተመረጠም')));out.push('   የተሟሉ መስፈርቶች፦ '+((r.answers||[]).filter(a=>a==='yes').length)+'/6','   ማስታወሻ/እርምጃ፦ '+(r.notes||'—'));});
 out.push('','==============================','የምትኬ ማስታወሻ፦ ይህ TXT ፋይል በቁጥር ተደርድሮ ለማንበብና ለሪፖርት ማሳያ ነው። ወደ አፑ መልሶ ለመጫን “JSON ምትኬ አውጣ” ይጠቀሙ።');
 saveBackupFile(filename||'Gazo_Merchant_Mibike.txt',out.join('\r\n'),'text/plain;charset=utf-8');
}
function csvCell(x){return '"'+String(x??'').replace(/"/g,'""')+'"'}function exportCSV(kind){let rows;if(kind==='m'){rows=[['ተራ ቁጥር','ስም','TIN','የንግድ ዘርፍ','ስልክ','ቀበሌ','የነጋዴ ምደባ','የፈቃድ እድሳት ሁኔታ'],...merchants.map((m,i)=>[i+1,m.name,m.tin,m.sector,m.phone,m.kebele,m.classification==='classified'?'የተፈረጀ':m.classification==='unclassified'?'ያልተፈረጀ':'',m.renewal==='renewed'?'ታድሷል':m.renewal==='not_renewed'?'አልታደሰም':m.renewal==='new'?'አዲስ':''])];download('Gazo_Merchants.csv',rows.map(r=>r.map(csvCell).join(',')).join('\r\n'),'text/csv;charset=utf-8')}else{rows=[['ቀን','ሩብ ዓመት','የነጋዴ ስም','TIN',...criteria,'የተሟሉ ብዛት','ያልተሟሉ ብዛት','የፈቃድ ሁኔታ','የተቆጣጣሪ ስም','ማስታወሻ'],...inspections.map(i=>[i.date?ethiopianDate(i.date):'',i.quarter?i.quarter+'ኛ ሩብ ዓመት':'',i.name,i.tin,...i.answers.map(a=>a==='yes'?'አሟልቷል':'አላሟላም'),i.answers.filter(a=>a==='yes').length,i.answers.filter(a=>a==='no').length,i.renewal==='renewed'?'ታድሷል':i.renewal==='not_renewed'?'አልታደሰም':i.renewal==='new'?'አዲስ':'',i.inspectorName||'',i.notes])];download('Gazo_Inspection_Report.csv',rows.map(r=>r.map(csvCell).join(',')).join('\r\n'),'text/csv;charset=utf-8')}}
