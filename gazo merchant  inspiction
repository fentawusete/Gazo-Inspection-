function normKey(v){return String(v||'').toLowerCase().replace(/[\s\-\/]+/g,'').trim()}
function merchantKey(m){const tin=normKey(m.tin); if(tin) return 'tin:'+tin; const name=normKey(m.name); return name ? 'name:'+name : ''}
const knownKeys=new Set(merchants.map(merchantKey).filter(Boolean));
let addedImported=0;
for(const src of IMPORTED_MERCHANTS){
  const key=merchantKey(src);
  if(key && knownKeys.has(key)){
    const existing=merchants.find(m=>merchantKey(m)===key);
    if(existing){ for(const field of ['name','tin','sector','kebele','phone','renewal','address']) if((!existing[field] || String(existing[field]).trim()==='') && src[field]) existing[field]=src[field]; }
    continue;
  }
  merchants.push({...src}); if(key) knownKeys.add(key); addedImported++;
}
