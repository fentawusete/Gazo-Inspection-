function searchMerchants(q,container){
 q=q.trim().toLowerCase();
 const matched=merchants.filter(m=>!q||[m.name,m.tin,m.kebele].some(v=>(v||'').toLowerCase().includes(q)));
 const serial=new Map();let n=1;
 // Keep classified merchants at the beginning of the numbering, then unclassified, then records with no classification entered.
 const ordered=[...matched.filter(m=>m.classification==='classified'),...matched.filter(m=>m.classification==='unclassified'),...matched.filter(m=>!m.classification)];
 ordered.forEach(m=>serial.set(m.id,n++));
 const card=m=>`<div class="merchant"><strong>${serial.get(m.id)}. ${esc(m.name||'ስም የለም')}</strong><div class="muted">TIN: ${esc(m.tin||'—')}<br>የንግድ ዘርፍ: ${esc(m.sector||'—')}<br>አድራሻ: ${esc(m.kebele||'—')}<br>ምደባ: ${m.classification==='classified'?'የተፈረጀ':m.classification==='unclassified'?'ያልተፈረጀ':'ምደባ አልተመዘገበም'}</div><div class="rowbtn"><button class="btn secondary" onclick="chooseMerchant('${m.id}')">ምረጥ / ቁጥጥር ጀምር</button><button class="btn danger" onclick="deleteMerchant('${m.id}')">🗑 ነጋዴውን ድሊት አድርግ</button></div></div>`;
 const group=(title,list)=>`<h3 style="margin:14px 0 6px">${title} (${list.length})</h3>${list.length?list.map(card).join(''):'<div class="empty">በዚህ ክፍል የተመዘገበ ነጋዴ የለም።</div>'}`;
 const classified=ordered.filter(m=>m.classification==='classified');
 const unclassified=ordered.filter(m=>m.classification==='unclassified');
 const unmarked=ordered.filter(m=>!m.classification);
 const inspectedIds=new Set(inspections.map(r=>r.merchantId).filter(Boolean).map(String));
 const inspectedNames=new Set(inspections.map(r=>(r.name||'').trim().toLowerCase()));
 const notWorked=ordered.filter(m=>!inspectedIds.has(String(m.id))&&!inspectedNames.has((m.name||'').trim().toLowerCase()));
 container.innerHTML=ordered.length?group('የተፈረጁ ነጋዴዎች',classified)+group('ያልተፈረጁ ነጋዴዎች',unclassified)+group('ምደባቸው ያልተመዘገበ ነጋዴዎች',unmarked)+group('ገና ቁጥጥር ያልተደረገባቸው ነጋዴዎች',notWorked):'<div class="empty">መረጃ አልተገኘም። አዲስ ነጋዴ መመዝገብ ይችላሉ።</div>';
}
