rgin:0 0 10px}.choices{display:flex;gap:8px}.choices label{flex:1;text-align:center;border:1px solid var(--line);border-radius:9px;padding:9px;font-size:13px}.choices input{margin-right:5px}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.stat{background:var(--mint);border-radius:10px;padding:12px;text-align:center}.stat b{display:block;font-size:22px;color:var(--green)}.stat span{font-size:12px}.rowbtn{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.small{font-size:12px}.empty{text-align:center;color:var(--muted);padding:20px}.notice{background:#fff8e5;border:1px solid #f2d58c;color:#6c4d00;padding:11px;border-radius:10px;font-size:13px;line-height:1.5;margin-bottom:12px}footer{text-align:center;color:var(--muted);font-size:12px;padding:12px}@media(max-width:420px){.grid{grid-template-columns:1fr}.nav button{font-size:12px}.stats span{font-size:11px}}
