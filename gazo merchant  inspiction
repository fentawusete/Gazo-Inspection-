function availableEthiopianYears(){
 const current=Number(ethiopianYear(new Date()))||2019;
 const stored=inspections.map(r=>Number(ethiopianYear(r.date))).filter(y=>Number.isFinite(y)&&y>0);
 // Offer future years too, without limiting the app to 2019 or the current year.
 const latest=Math.max(current,...stored,2019)+20;
