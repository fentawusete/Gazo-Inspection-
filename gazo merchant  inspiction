 for(let y=latest;y>=2019;y--) years.push(String(y));
 // Preserve any historical data older than 2019 if present in a backup.
 stored.filter(y=>y<2019).sort((a,b)=>b-a).forEach(y=>years.push(String(y)));
 return [...new Set(years)];
}
function deleteInspection(id){if(confirm('ይህን የቁጥጥር መዝገብ ለመሰረዝ እርግጠኛ ነዎት?')){inspections=inspections.filter(i=>i.id!==id);persist();renderAll()}}
function populateReportYears(){
 const sel=$('reportYear');if(!sel)return;
 const current=String(Number(ethiopianYear(new Date()))||2019), ys=availableEthiopianYears(), old=sel.value;
 sel.innerHTML=ys.map(y=>'<option value="'+esc(y)+'">'+esc(y)+' ዓ.ም.</option>').join('');
 sel.value=ys.includes(old)?old:(ys.includes(current)?current:ys[0]);
 const ms=$('merchantQuarterYear'); if(ms){const oldM=ms.value||'all';ms.innerHTML='<option value="all">ሁሉም ዓመታት</option>'+ys.map(y=>'<option value="'+esc(y)+'">'+esc(y)+' ዓ.ም.</option>').join('');ms.value=(oldM==='all'||ys.includes(oldM))?oldM:'all';}
}
